debug on

title Flashcards parsers

title_in_head

The flashcards parser handles all of these syntaxes:
	aftertext_code flashcards

code markup
	Q: <front> A: <back>
		reversed

	Q: <front>
		A: <back>

	Q: <front>
		A:
			<back>
		reversed

	Q:
		<front>
		A: <back>

	Q:
		<front>
		A:
			<back>


parser flashcards
	cue Q:
	arg_as_content
	build_html
		lua
		local before = {}
		local after = {}
		local seen_answer = false
		for i = 2, #this.atoms do
			if this.atoms[i] == "A:" then
				seen_answer = true
				elseif seen_answer then
				table.insert(after, this.atoms[i])
			else
				table.insert(before, this.atoms[i])
			end
		end
		local front = ""
		local back = ""
		if seen_answer then
			front = parse_markup(table.concat(before, " "))
			back = parse_markup(table.concat(after, " "))
		else
			front = this.content
			back = find_subparticle("flashcard_back").content
		end
		local reversed = find_subparticle("flashcard_reversed_flag") ~= nil and ' reversed' or ''
		return string.format('<div class="flashcard%s"><div class="flashcard-front">%s</div><div class="flashcard-back">%s</div></div>', reversed, front, back)
	metadata
		lua
		local before = {}
		local after = {}
		local seen_answer = false
		for i = 2, #this.atoms do
			if this.atoms[i] == "A:" then
				seen_answer = true
				elseif seen_answer then
				table.insert(after, this.atoms[i])
			else
				table.insert(before, this.atoms[i])
			end
		end
		local front = ""
		local back = ""
		if seen_answer then
			front = parse_markup(table.concat(before, " "))
			back = parse_markup(table.concat(after, " "))
		else
			front = this.content:gsub("\n", "\\n")
			back = find_subparticle("flashcard_back").content:gsub("\n", "\\n")
		end
		local reversed = find_subparticle("flashcard_reversed_flag") ~= nil and 'true' or 'false'
		return string.format('%s\t%s\t%s', front, back, reversed)

parser flashcard_back
	cue A:
	arg_as_content

parser flashcard_reversed_flag
	cue reversed

A tsv file containing the flashcards found in the document can then be generated with the following parser:

parser generate_flashcards_tsv
	build_html
		lua
		local rows = metadata["flashcards"] or {}
		local front = {}
		local back = {}
		local reversed = {}
		for _, row in ipairs(rows) do
				local a, b, c = row:match("^(.-)\t(.-)\t(.*)$")
				if a and b and c then
						table.insert(front, a)
						table.insert(back, b)
						table.insert(reversed, c)
				end
		end
		-- generate tsv
		local tsv_lines = {}
		for i = 1, #front do
				tsv_lines[#tsv_lines + 1] = front[i] .. "\t" .. back[i] .. "\t" .. reversed[i]
		end
		local contents = table.concat(tsv_lines, "\n")
		-- write the file
		local output_path = dirname(file_path) .. "/flashcards.tsv"
		write_file(output_path, contents)
		return "" -- this is how to execute code without producing HTML

parser fc_ref

parser flashcards
	cue as_flashcard
	aftertext lua return ""
	metadata
		lua
			local env_name, title, content = parent_html:match(
				'<div%s+class="environment%s+environment%-([^"]+)"%s*>%s*' ..
				'<div%s+class="environment%-title">%s*(.-)%s*</div>(.-)' ..
				'</div>%s*$'
			)
			if content ~= nil then
				local reversed = find_subparticle("flashcard_reversed_flag") ~= nil and 'true' or 'false'
				return string.format('%s	%s	%s', title, content:match("^%s*(.-)%s*$"), reversed)
			else
				return ""
			end
	build_html
		lua
			-- return parent_html
			local env_name, title, content = parent_html:match(
				'<div%s+class="environment%s+environment%-([^"]+)"%s*>%s*' ..
				'<div%s+class="environment%-title">%s*(.-)%s*</div>(.-)' ..
				'</div>%s*$'
			)
			if this.arg ~= "" then
				title = this.arg
			end
			if content ~= nil then
				return string.format('%s<div class="flashcard"><div class="flashcard-front">%s</div><div class="flashcard-back">%s</div></div>', parent_html, title, content:match("^%s*(.-)%s*$"))
			else
				return parent_html
			end




