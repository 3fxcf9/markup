debug on

title Flashcards parsers

title_in_head

The flashcards parser handles all of these syntaxes:
	aftertext_code flashcards

code markup
	Q: <front> A: <back>
		reversed

	Q: <front>
		A: <back>

	Q: <front>
		A:
			<back>
		reversed

	Q:
		<front>
		A: <back>

	Q:
		<front>
		A:
			<back>


parser flashcards
	cue Q:
	arg_as_content
	build_html
		lua
		local before = {}
		local after = {}
		local seen_answer = false
		for i = 2, #this.atoms do
			if this.atoms[i] == "A:" then
				seen_answer = true
				elseif seen_answer then
				table.insert(after, this.atoms[i])
			else
				table.insert(before, this.atoms[i])
			end
		end
		local front = ""
		local back = ""
		if seen_answer then
			front = parse_markup(table.concat(before, " "))
			back = parse_markup(table.concat(after, " "))
		else
			front = this.content
			back = find_subparticle("flashcard_back").content
		end
		local reversed = find_subparticle("flashcard_reversed_flag") ~= nil and ' reversed' or ''
		return string.format('<div class="flashcard%s"><div class="flashcard-front">%s</div><div class="flashcard-back">%s</div></div>', reversed, front, back)
	metadata
		lua
		local before = {}
		local after = {}
		local seen_answer = false
		for i = 2, #this.atoms do
			if this.atoms[i] == "A:" then
				seen_answer = true
				elseif seen_answer then
				table.insert(after, this.atoms[i])
			else
				table.insert(before, this.atoms[i])
			end
		end
		local front = ""
		local back = ""
		if seen_answer then
			front = parse_markup(table.concat(before, " "))
			back = parse_markup(table.concat(after, " "))
		else
			front = this.content:gsub("\n", "\\n")
			back = find_subparticle("flashcard_back").content:gsub("\n", "\\n")
		end
		local reversed = find_subparticle("flashcard_reversed_flag") ~= nil and 'true' or 'false'
		return string.format('%s\t%s\t%s', front, back, reversed)

parser flashcard_back
	cue A:
	arg_as_content

parser flashcard_reversed_flag
	cue reversed

parser fc_ref

parser flashcards
	cue as_flashcard
	aftertext *
	metadata
		lua
			local env_name, title, content = parent_html:match(
				'<div%s+class="environment%s+environment%-([^"]+)"%s*>%s*' ..
				'<div%s+class="environment%-title">%s*(.-)%s*</div>(.-)' ..
				'</div>%s*$'
			)
			if content ~= nil then
				local reversed = find_subparticle("flashcard_reversed_flag") ~= nil and 'true' or 'false'
				return string.format('%s	%s	%s', title, content:match("^%s*(.-)%s*$"), reversed)
			else
				return ""
			end
	build_html
		lua
			-- return parent_html
			local env_name, title, content = parent_html:match(
				'<div%s+class="environment%s+environment%-([^"]+)"%s*>%s*' ..
				'<div%s+class="environment%-title">%s*(.-)%s*</div>(.-)' ..
				'</div>%s*$'
			)
			if this.arg ~= "" then
				title = inline(this.arg)
			end
			if content ~= nil then
				return string.format('%s<div class="flashcard"><div class="flashcard-front">%s</div><div class="flashcard-back">%s</div></div>', parent_html, title, content:match("^%s*(.-)%s*$"))
			else
				return parent_html
			end

A json file containing the flashcards found in the project can then be generated next to a specific with the following parser in that file:

parser generate_project_flashcards_json
	build_html
		lua
		function json(v)
			local t = type(v)
			if t == "nil" then return "null" end
			if t == "boolean" then return tostring(v) end
			if t == "number" then return tostring(v) end
			if t == "string" then
				return '"' .. v:gsub('[\\"%z\1-\31]', {
					['"'] = '\\"', ['\\'] = '\\\\',
					['\n'] = '\\n', ['\r'] = '\\r',
					['\t'] = '\\t', ['\b'] = '\\b', ['\f'] = '\\f'
				}) .. '"'
			end
			if t == "table" then
				local a, r, n = true, {}, 0
				for k, x in pairs(v) do
					if type(k) ~= "number" or k < 1 or k ~= math.floor(k) then
						a = false
						break
					end
					n = math.max(n, k)
				end
				if a then
					for i = 1, n do
						if v[i] == nil then a = false break end
						r[i] = json(v[i])
					end
					if a then return "[" .. table.concat(r, ",") .. "]" end
				end
				for k, x in pairs(v) do
					assert(type(k) == "string", "JSON keys must be strings")
					r[#r + 1] = json(k) .. ":" .. json(x)
				end
				return "{" .. table.concat(r, ",") .. "}"
			end
			error("cannot encode " .. t)
		end

		local flashcards = {}
		for _,path in ipairs(external_metadata_files()) do
			local meta = external_metadata[path] or {}
			if meta.title ~= nil then
				local macros = read_file(dirname(path) .. '/snippets.js') or ""
				local chap = {cards = {}, macros=macros}
				local rows = meta["flashcards"] or {}
				for _, row in ipairs(rows) do
					local a, b, c = row:match("^(.-)\t(.-)\t(.*)$")
					if a and b and c then
						table.insert(chap.cards, {hash=hash(a), front=a, back=b, reversed=c})
					end
				end
				if next(chap.cards) ~= nil then
					local subject = ((external_metadata[dirname(dirname(path)) .. '/index.markup'] or {}).title or {})[1]
					if subject ~= nil then
						flashcards[subject] = flashcards[subject] or {}
						flashcards[subject].chapters = flashcards[subject].chapters or {}
						flashcards[subject].chapters[meta.title[1]] = chap
					end
				end
			end
		end
		write_file(path_relative_to_toplevel("flashcards.json"), json(flashcards))
		return ""

