debug on

title Basic parsers

parser comment
	cue //

parser html
	raw
	build_html $content

parser html_end
	raw
	end_of_body
	build_html $content

parser head
	raw
	head
	build_html $content

parser css
	raw
	head
	build_html <style>$content</style>

parser css_file
	head
	build_html lua return '<style>' .. read_file(this.arg) .. '</style>'

parser css_file_link
	head
	build_html
		lua
		local dirname = this.arg:match("(.*/)")
		fs_copy(this.arg, dirname)
		return string.format('<link rel="stylesheet" href="/%s"/>', this.arg)

parser js
	raw
	end_of_body
	build_html <script>$content</script>

parser js_file
	end_of_body
	build_html lua return '<script>' .. read_file(this.arg) .. '</script>'

parser js_file_src
	end_of_body
	build_html
		lua
		local dirname = this.arg:match("(.*/)")
		fs_copy(this.arg, dirname)
		return string.format('<script src="/%s"></script>', this.arg)

parser div
	build_html
		lua
		if this.arg == '' then return '<div>'..this.content..'</div>' else
			return string.format('<div class="%s">%s</div>', this.arg, this.content)
		end

## Metadata

parser title
	metadata $arg
	build_html <h1>$arg</h1>
parser title_in_head
	build_html <title>$metadata[title]</title>
	head

parser date
	metadata $arg
parser print_date
	build_html <div class="date">$metadata[date]</div>

parser author
	metadata $arg
parser print_author
	build_html <div class="author">$metadata[author]</div>

## Headings
parser headings
	pattern \(#\|##\|###\|####\|#####\|######\)[ ]
	build_html
		lua
		local level = string.len(this.matched_groups[2])
		local id = (find_subparticle("id") or {}).arg or hash(this.arg)
		return string.format('<h%d id="%s">%s</h%d>', level, id, this.arg, level)
	metadata
		lua
		local level = string.len(this.matched_groups[2])
		local id = (find_subparticle("id") or {}).arg or hash(this.arg)
		return string.format('%d;%s;%s', level, id, this.arg)

parser table_of_contents
	build_html
		lua
			function generate_toc(headings)
				local root = { level = 0, children = {} }
				local stack = { root }

				for _, line in ipairs(headings) do
					local level, id, text = line:match("^(%d+);([^;]*);(.*)$")
					level = tonumber(level)

					if level then
						while #stack > 1 and stack[#stack].level >= level do
							table.remove(stack)
						end

						local node = {
							level = level,
							id = id,
							text = text,
							children = {}
						}

						table.insert(stack[#stack].children, node)
						table.insert(stack, node)
					end
				end

				local function render(nodes, root)
					local out = { root and '<ol class="toc">' or '<ol>' }

					for _, node in ipairs(nodes) do
						table.insert(out, '<li><a href="#' .. node.id .. '">' .. node.text .. '</a>')

						if #node.children > 0 then
								table.insert(out, render(node.children))
						end

						table.insert(out, '</li>')
					end

					table.insert(out, '</ol>')
					return table.concat(out)
				end

				return render(root.children, true)
			end

			local path = relative_path .. '/' .. filename
			return generate_toc(external_metadata[path].headings or {})

## Blocs
parser hrule
	build_html <hr/>

parser link
	build_html lua return string.format('<a href="%s">%s</a>', this.atoms[2], table.concat(this.atoms, " ", 3))

parser code
	cue code
	raw
	build_html
		lua
		local attr = this.arg == '' and '' or string.format(' class="lang-%s"', this.arg)
		return string.format('<pre><code%s>%s</code></pre>', attr, escape(this.content))

parser math
	cue math
	raw
	build_html <code class="katex-display">$content</code>

parser sidenote
	build_html lua return string.format('<span class="sidenote-number"><small class="sidenote">%s%s</small></span>', this.arg == "" and "" or '<p>'..this.arg..'</p>', this.content)

## Lists

parser list
	cue -
	build_html <li>$content</li>
	list_wrap <ul>$elements</ul>
	arg_as_content

parser todo
	pattern \[\(x\|X?\)\]
	build_html
		lua
		local icon = this.matched_groups[2] == '' and '☐' or '☒'
		return string.format('<li><div class="check-icon">%s</div>%s</li>', icon, this.content)
	list_wrap <ul>$elements</ul>
	arg_as_content
