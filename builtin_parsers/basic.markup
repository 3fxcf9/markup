parser comment
	cue //

// Metadata
parser title
	metadata $arg
	build_html <h1>$arg</h1>

parser title_in_head
	build_html <title>$metadata[title]</title>
	head

parser date
	metadata $arg

parser print_date
	build_html <div class="date">$metadata[date]</div>

parser author
	metadata $arg

parser print_author
	build_html <div class="author">$metadata[author]</div>

// Headings
parser headings
	pattern \(##\|###\|####\|#####\|######\)[ ]
	build_html
		lua
		local level = string.len(this.matched_groups[2])
		return string.format("<h%d>%s</h%d>", level, this.arg, level)

// Blocs
parser code
	cue code
	raw
	build_html
		lua
		local attr = this.arg == '' and '' or string.format(' class="lang-%s"', this.arg)
		return string.format('<pre><code%s>%s</code></pre>', attr, content)

parser math
	cue math
	raw
	build_html <code class="katex-display">$content</code>

parser list
	cue -
	build_html <li>$arg$content</li>
	list_wrap <ul>$elements</ul>
	arg_as_content
