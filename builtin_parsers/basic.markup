debug on

title Basic parsers

parser comment
	cue //

parser html
	raw
	build_html $content

parser head
	raw
	head
	build_html $content

parser css
	raw
	head
	build_html <style>$content</style>

parser js
	raw
	head
	build_html <script>$content</script>

parser div
	build_html
		lua
		if this.arg == '' then return '<div>'..this.content..'</div>' else
			return string.format('<div class="%s">%s</div>', this.arg, this.content)
		end

## Metadata

parser title
	metadata $arg
	build_html <h1>$arg</h1>
parser title_in_head
	build_html <title>$metadata[title]</title>
	head

parser date
	metadata $arg
parser print_date
	build_html <div class="date">$metadata[date]</div>

parser author
	metadata $arg
parser print_author
	build_html <div class="author">$metadata[author]</div>

## Headings
parser headings
	pattern \(#\|##\|###\|####\|#####\|######\)[ ]
	build_html
		lua
		local level = string.len(this.matched_groups[2])
		return string.format("<h%d>%s</h%d>", level, this.arg, level)

## Blocs
parser hrule
	build_html <hr/>

parser link
	build_html lua return string.format('<a href="%s">%s</a>', this.atoms[2], table.concat(this.atoms, " ", 3))

parser code
	cue code
	raw
	build_html
		lua
		local attr = this.arg == '' and '' or string.format(' class="lang-%s"', this.arg)
		return string.format('<pre><code%s>%s</code></pre>', attr, escape(this.content))

parser math
	cue math
	raw
	build_html <code class="katex-display">$content</code>

parser sidenote
	build_html lua return string.format('<span class="sidenote-number"><small class="sidenote">%s%s</small></span>', this.arg == "" and "" or '<p>'..this.arg..'</p>', this.content)

## Lists

parser list
	cue -
	build_html <li>$content</li>
	list_wrap <ul>$elements</ul>
	arg_as_content

parser todo
	pattern \[\(x\|X?\)\]
	build_html
		lua
		local icon = this.matched_groups[2] == '' and '☐' or '☒'
		return string.format('<li><div class="check-icon">%s</div>%s</li>', icon, this.content)
	list_wrap <ul>$elements</ul>
	arg_as_content
