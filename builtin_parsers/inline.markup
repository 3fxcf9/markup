debug on

title Inline parsers

title_in_head

This is a collection of inline parsers. They are aftertext parsers, using regular expressions to replace inline markdown syntax. The `inline_markup` parser gathers all of them and is automatically set as a subparticle of the paragraph parser (see the `collect_subparticles` function in `parser.ml`). This way, inline marking can be used in paragraphs without additional cost.

parser inline_bold
	aftertext pattern \*\([^*]*\)\*
	build_html <strong>$aftertext_matched_groups[1]</strong>
parser inline_italic
	aftertext pattern _\([^_]*\)_
	build_html <i>$aftertext_matched_groups[1]</i>
parser inline_highlight
	aftertext pattern ==\([^=]*\)==
	build_html <mark>$aftertext_matched_groups[1]</mark>
parser inline_underline
	aftertext pattern \+\+\([^+]*\)\+\+
	build_html <u>$aftertext_matched_groups[1]</u>
parser inline_strikethrough
	aftertext pattern ~~\([^~]*\)~~
	build_html <s>$aftertext_matched_groups[1]</s>

Please do not change the following two parsers, as the inline replacement strategy assumes this implementation (it only replaces matches that are prefixed by a string containing an even number of backticks and an even number of dollars).
parser inline_math
	aftertext pattern \$\([^$]*\)\$
	build_html <code class="katex-inline">$aftertext_matched_groups[1]</code>
parser inline_code
	aftertext pattern `\([^`]*\)`
	build_html lua return string.format('<code>%s</code>', escape(aftertext_matched_groups[2]))

## Footnotes

code
	some text here^foot
	^foot Caption here.
		// label +

parser footnotes
	cue inline_footnotes
	aftertext pattern \^\([1-9A-Za-z_-]+\)
	build_html
		lua
		local i = 0
		for j, v in ipairs(metadata["footnotes"] or {}) do
			if v == aftertext_matched_groups[2] then
				i=j
				break
			end
		end
		if i > 0 then
			return string.format('<a id="note-ref-%d" href="#note-%d"><sup>[%d]</sup></a>', i, i, i)
		else
			local i = #metadata["footnotes"]
			return string.format('<a id="note-ref-%d" href="#note-%d"><sup>[%d]</sup></a>', i, i, i)
		end
	metadata
		lua
		local i = 0
		for j, v in ipairs(metadata["footnotes"] or {}) do
			if v == aftertext_matched_groups[2] then
				i=j
				break
			end
		end
		if i == 0 then
			return aftertext_matched_groups[2]
		else return "" end

parser label

parser footnote_text
	pattern \^\([1-9A-Za-z_-]+\)
	build_html
		lua
		local i = 0
		for j, v in ipairs(metadata["footnotes"] or {}) do
			if v == this.matched_groups[2] then
				i=j
				break
			end
		end
		if i > 0 then
			local label = ((find_subparticle("label") or {}).atoms or {})[2]
			local js = label ~= nil and string.format('<script>document.querySelectorAll("#note-ref-%d > sup").forEach(e => e.innerText = "%s")</script>', i, label) or ""
			return string.format('%s<p id="note-%d"><a href="#note-ref-%d">%s</a> %s</p>', js, i, i, label ~= nil and label or '['..i..']', this.arg)
		else
			return "Invalid"
		end

parser inline_markup
	markup
		inline_bold
		inline_italic
		inline_highlight
		inline_underline
		inline_strikethrough
		inline_footnotes
		// The two following parsers must be last
		inline_math
		inline_code

