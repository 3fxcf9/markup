title Project name
date 2026

common/header.lib.markup

parser subject
	build_html
		<a href="$arg">
			<div class="subject">
				<span class="subject-title">$external_metadata[$arg/index][title]</span>
				<span class="subject-teacher">$external_metadata[$arg/index][teacher]</span>
			</div>
		</a>
	list_wrap <div class="subject-grid">$elements</div>

css
	.subject-grid {
		display: flex;
		gap: 2rem;
		& a {text-decoration: none;}
	}
	.subject {
		color: black;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		border: 1px solid;
		border-radius: .5rem;
		padding: .5rem;
		margin-bottom: 1rem;
	}
	.subject-title {
		font-weight: bold;
	}
	.subject-teacher {
		font-style: italic;
	}


subject math
subject physics
