common/header.lib.markup

parser copy_font_directory
	build_html
		lua
		fs_copy('common/static/fonts', 'common/static')
		return ''

copy_font_directory

css
	.header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 3rem;
	}

	.subject-grid {
		display: grid;
		gap: 1em;
		grid-template-columns: repeat(auto-fit, minmax(15em, 1fr));
		grid-auto-flow: row;
	}

	@media screen and (max-width: 700px) {
		.subject-grid {
			grid-template-columns: 1fr;
		}
	}

	.subject {
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--subtext-color);
	}

	.cover {
		height: 5em;
		background-size: cover;
		background-position: center;
		opacity: 0.7;
		transition: opacity 0.1s ease;
	}

	.title:hover .cover {
		opacity: 1;
	}

	.content {
		padding: 1em;
	}

	.subject-title {
		font-weight: bold;
		font-size: 1.1em;
	}

	.subject-subtitle {
		font-style: italic;
	}


div header
	title Project name
	date 2026-2027
	print_date

parser subject
	build_html
		<a class="subject" href="$arg">
			<div class="cover" style="background-color: #aaaaff22"></div>
			<div class="content">
				<div class="subject-title">$external_metadata[$arg/index][title]</div>
				<div class="subject-teacher">$external_metadata[$arg/index][teacher]</div>
			</div>
		</a>
	list_wrap <div class="subject-grid">$elements</div>

subject math
subject physics
