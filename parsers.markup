parser test
	cue test
	build_html
		lua
		return this.arg

parser test2
	cue test2
	build_html lua return this.arg

parser code
	cue code
	raw
	build_html <pre><code class="lang-$arg">$content</code></pre>

parser math
	cue math
	raw
	build_html <code class="katex-display">$content</code>

parser link
	pattern https?://
	build_html
		lua
		local url = this.atoms[1]
		return '<a href="' .. url .. '">' .. replaced .. '</a>'
	aftertext $arg

parser bold
	cue bold
	aftertext $arg
	build_html <strong>$replaced</strong>

parser list
	cue -
	build_html <li>$arg$content</li>
	list_wrap <ul>$elements</ul>
