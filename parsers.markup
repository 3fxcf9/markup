parser test
	cue test
	build_html
		lua
		return this.arg

parser test2
	cue test2
	build_html lua return this.arg

parser code
	cue code
	raw
	build_html <pre><code class="lang-$arg">$content</code></pre>

parser math
	cue math
	raw
	build_html <code class="katex-display">$content</code>

parser link
	pattern https?://
	build_html
		lua
		local url = this.atoms[1]
		local text = this.arg or url
		return '<a href="' .. url .. '">' .. text .. '</a>'
	aftertext $arg

parser bold
	cue bold
	aftertext $arg
	build_html <strong>$arg</strong>
